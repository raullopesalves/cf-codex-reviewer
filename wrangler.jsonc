{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-reviewer",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  // Per-IP limit on /api/chat, which is the only route that calls the model.
  "ratelimits": [{ "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "workflows": [
    { "name": "codex-review", "binding": "REVIEW_WORKFLOW", "class_name": "ReviewWorkflow" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "REPO_MEMORY", "class_name": "RepoMemory" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RepoMemory"] }]
}
